{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@omc/provider-sdk": ["packages/provider-sdk/src/index.ts"],
      "@omc/data-engine": ["packages/data-engine/src/index.ts"],
      "@omc/indicator-engine": ["packages/indicator-engine/src/index.ts"],
      "@omc/drawing-engine": ["packages/drawing-engine/src/index.ts"],
      "@omc/chart-core": ["packages/chart-core/src/index.ts"],
      "@omc/chart-renderer": ["packages/chart-renderer/src/index.ts"]
    }
  },
  "include": [
    "apps",
    "packages",
    "scripts",
    "tests",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ]
}
