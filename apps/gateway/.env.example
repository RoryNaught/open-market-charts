# Export these in the server process; never use VITE_ for provider secrets.
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_PAPER=true

OMC_GATEWAY_HOST=127.0.0.1
OMC_GATEWAY_PORT=8787
# Optional for loopback; mandatory (32+ characters) for remote binding.
OMC_GATEWAY_TOKEN=
OMC_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173
